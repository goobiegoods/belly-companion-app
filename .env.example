VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_POSTHOG_KEY="your-posthog-project-key"
VITE_POSTHOG_HOST="https://us.i.posthog.com"
# Stripe publishable key (pk_test_… / pk_live_…) for the embedded checkout.
VITE_PAYMENTS_CLIENT_TOKEN="pk_test_your-stripe-publishable-key"
# Hard paywall. Stays "0" until Stripe live keys are in; "1" locks free users
# behind the post-welcome 7-day-trial wall.
VITE_HARD_PAYWALL="0"

# ---- Landing funnel (server-only; set in Vercel, never commit real values) ----
# See LAUNCH-NOTES.md. Preview/dev = Stripe TEST keys only.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
SUPABASE_SERVICE_ROLE_KEY=""
FUNNEL_SIGNING_SECRET=""      # random, 48+ chars
FUNNEL_HEALTH_KEY=""          # random
RESEND_API_KEY=""
RESEND_FROM="Belly <hello@meetbelly.com>"
RESEND_AUDIENCE_ID=""         # optional
META_PIXEL_ID=""
META_CAPI_TOKEN=""
META_TEST_EVENT_CODE=""       # preview only
APP_URL=""                    # prod: https://app.meetbelly.com
LANDING_URL=""                # prod: https://meetbelly.com
FUNNEL_LIVE_APPROVED=""       # leave empty — live checkout stays OFF until a human sets "yes"
